generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id   String   @id
  email String  @unique
  password String
  projects Project[]
  tokens RefreshToken[]
}

model Project {
  id   String   @id @unique
  name String
  owner String
  url String
  stars Int
  forks Int
  issues Int
  created_at Int
  user User @relation(fields: [user_id], references: [id])
  user_id String

  @@index([user_id])
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  user       User     @relation(fields: [user_id], references: [id])
  user_id     String
  created_at  DateTime @default(now())
  expires_at  Int
  revoked    Boolean  @default(false)

  @@index([user_id])
}
